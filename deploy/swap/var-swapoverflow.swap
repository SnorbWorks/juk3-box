# JUKE.BOX overflow swap: a 512 MB file on the SD card, used only once the
# zram swap (rpi-swap, priority 100) is full. With 1 GB of RAM the kiosk's
# Chromium plus the jb-* services sit close to the limit; without this the
# kernel OOM-kills the kiosk on a spike (2026-10-13, scrolling Home). With
# it, a spike is a brief slowdown instead.
#
# Install (once):
#   sudo fallocate -l 512M /var/swapoverflow && sudo chmod 600 /var/swapoverflow
#   sudo mkswap /var/swapoverflow
#   sudo cp deploy/swap/var-swapoverflow.swap /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now var-swapoverflow.swap
# Undo: sudo systemctl disable --now var-swapoverflow.swap && sudo rm /var/swapoverflow

[Unit]
Description=JUKE.BOX overflow swap (after zram)
After=local-fs.target

[Swap]
What=/var/swapoverflow
Priority=10

[Install]
WantedBy=swap.target
