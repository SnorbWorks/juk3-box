#!/usr/bin/python3
"""jb-setupctl: the setup wizard's privileged steps (docs/Setup Wizard —
Plan.md). Like jb-modctl: it runs as root, started by systemd when jb-admin
drops a request in REQUESTS (jb-setupctl.path), and answers in RESPONSES.
No sudo rule is involved. Everything it's asked is checked here again, and
it only ever does these:

    jb-setupctl psu 5000|unset            the Pi 5's PSU_MAX_CURRENT (board EEPROM, next boot)
    jb-setupctl rtc-charge on|off         charge the official RTC battery (config.txt, next boot)
    jb-setupctl fan 0..4|auto             spin the Pi 5's fan for the cooling check
    jb-setupctl timezone Area/City        the clock's time zone
    jb-setupctl wifi-country CC           the Wi-Fi regulatory country
    jb-setupctl lights identify CHAIN SECONDS | load CHAINS SECONDS | stop
                                          the light checks, with jb-lights paused
    jb-setupctl lastfm KEY|clear          the owner's Last.fm API key, in jb-library's and
                                          jb-analyzer's config (restarts them)
    jb-setupctl update check|apply|auto-on|auto-off
                                          the admin's Updates card (deploy/jb-update); apply
                                          runs on its own (it restarts the jukebox, jb-admin too)
    jb-setupctl keypad status|install|update [replace]
                                          the Pico keypad board (firmware/pico-keypad): what's
                                          plugged in; CircuitPython and our program on a blank
                                          one (its RPI-RP2 drive); our program onto one showing
                                          its CIRCUITPY drive ("replace" if it has other software)
    jb-setupctl hostname check|set NAME   the cabinet's address on the network (NAME.local, from
                                          its name): is another device already using it; use it
    jb-setupctl serve                     answer every waiting request

config.txt is only ever changed inside its own marked block at the end
(after a dated backup, as docs/pi5-move.md did by hand). Installed copy:
/usr/local/sbin/jb-setupctl, root-owned (deploy.sh copies it there).
A request is {"verb": ..., "args": [...]}; its answer {"ok", "out", "error"}
has the same file name.
"""

import datetime
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

CONFIG = Path("/boot/firmware/config.txt")
MODEL = Path("/proc/device-tree/model")
THERMAL = Path("/sys/class/thermal")
ZONEINFO = Path("/usr/share/zoneinfo")
REPO = Path("/opt/juk3-box")
PYTHON = REPO / "venv" / "bin" / "python"
REQUESTS = Path("/var/lib/juk3-box/setupctl/requests")
RESPONSES = Path("/var/lib/juk3-box/setupctl/responses")
REQ_NAME_RE = re.compile(r"^[A-Za-z0-9_-]{8,64}\.json$")
TZ_RE = re.compile(r"^[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+){0,2}$")
CHAINS = ("buttons", "accent", "levelbar")
UPDATE = "/usr/local/sbin/jb-update"
UPDATE_UNIT = "jb-update-now"
ETC = Path("/etc/juk3-box")
# Each service's name for the Last.fm key in its config file.
LASTFM_FIELDS = {"jb-library": "lastfm_api_key", "jb-analyzer": "lastfm_key"}
LASTFM_KEY_RE = re.compile(r"^[0-9a-f]{32}$")
TEST_UNIT = "jb-lighttest"
# The keypad board (docs/Controls Setup — Plan.md, step 1).
FIRMWARE = REPO / "firmware" / "pico-keypad"
UF2 = FIRMWARE / "vendor" / "adafruit-circuitpython-raspberry_pi_pico-en_US-10.3.1.uf2"
HID_LIB = FIRMWARE / "vendor" / "lib" / "adafruit_hid"
PROGRAM = ("jbsignal.py", "config.py", "code.py", "boot.py")   # boot.py last: it takes effect on a restart
KEYPAD_MOUNTS = Path("/run/juk3-box-keypad")
PICO_VERSION_RE = re.compile(r'^VERSION = "([0-9][0-9.]*)"', re.M)
CIRCUITPY_WAIT_S = 45
HOSTNAME_RE = re.compile(r"^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$")
HOSTS = Path("/etc/hosts")
AVAHI = ("busctl", "call", "org.freedesktop.Avahi", "/", "org.freedesktop.Avahi.Server")

BEGIN = "# --- juk3box setup: written by jb-setupctl (the admin's Setup page); don't edit by hand ---"
END = "# --- end juk3box setup ---"
RTC_CHARGE = "dtparam=rtc_bbat_vchg=3000000"


class Refused(Exception):
    pass


def die(msg: str):
    raise Refused(msg)


def run(*cmd, check=True, **kw):
    return subprocess.run(cmd, check=check, capture_output=True, text=True, **kw)


def is_pi5() -> bool:
    try:
        return "Raspberry Pi 5" in MODEL.read_text(errors="replace")
    except OSError:
        return False


def write(path: Path, text: str, mode: int = 0o644):
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
    with os.fdopen(fd, "w") as f:
        f.write(text)
        f.flush()
        os.fsync(f.fileno())
    os.chmod(tmp, mode)
    os.replace(tmp, path)


# config.txt: our block --------------------------------------------------------

def managed(text: str, lines: list[str]) -> str:
    """config.txt with our block holding `lines` (under [pi5], then back to
    [all] so anything appended later isn't caught by it), or without the
    block when there are none. Everything outside the block is kept."""
    out, inside = [], False
    for line in text.splitlines():
        if line.strip() == BEGIN:
            inside = True
            continue
        if inside:
            if line.strip() == END:
                inside = False
            continue
        out.append(line)
    while out and not out[-1].strip():
        out.pop()
    if lines:
        out += ["", BEGIN, "[pi5]", *lines, "[all]", END]
    return "\n".join(out) + "\n"


def block_lines(text: str) -> list[str]:
    lines, inside = [], False
    for line in text.splitlines():
        if line.strip() == BEGIN:
            inside = True
        elif line.strip() == END:
            inside = False
        elif inside and line.strip() and not line.startswith("[") and not line.startswith("#"):
            lines.append(line.strip())
    return lines


def set_block_line(line: str, on: bool) -> str:
    text = CONFIG.read_text()
    lines = [x for x in block_lines(text) if x != line] + ([line] if on else [])
    new = managed(text, lines)
    if new == text:
        return "unchanged"
    backup = CONFIG.with_name(f"config.txt.bak-{datetime.date.today():%Y%m%d}")
    if not backup.exists():
        shutil.copy2(CONFIG, backup)
    write(CONFIG, new, 0o755 if os.access(CONFIG, os.X_OK) else 0o644)
    return "changed; applies on the next restart"


# The EEPROM ----------------------------------------------------------------------

def eeprom_with(text: str, value: str | None) -> str:
    """The bootloader config with PSU_MAX_CURRENT set to `value`, or removed."""
    lines = [x for x in text.splitlines() if not x.strip().startswith("PSU_MAX_CURRENT=")]
    if value is not None:
        lines.append(f"PSU_MAX_CURRENT={value}")
    return "\n".join(lines).strip() + "\n"


def cmd_psu(value: str) -> str:
    if not is_pi5():
        die("PSU_MAX_CURRENT is a Raspberry Pi 5 setting")
    if value not in ("5000", "unset"):
        die("psu takes 5000 or unset")
    current = run("rpi-eeprom-config").stdout
    new = eeprom_with(current, None if value == "unset" else value)
    if new.strip() == current.strip():
        return "unchanged"
    with tempfile.NamedTemporaryFile("w", suffix=".conf", delete=False) as f:
        f.write(new)
        path = f.name
    try:
        run("rpi-eeprom-config", "--apply", path)
    finally:
        os.unlink(path)
    return "changed; applies on the next restart"


# The rest ------------------------------------------------------------------------

def fan_device() -> Path:
    for d in sorted(THERMAL.glob("cooling_device*")):
        try:
            if (d / "type").read_text().strip() == "pwm-fan":
                return d
        except OSError:
            continue
    die("no fan on the FAN connector")


def cmd_fan(level: str) -> str:
    d = fan_device()
    top = int((d / "max_state").read_text().strip())
    if level == "auto":
        level = "0"       # the firmware's thermal governor takes over from here
    if not level.isdigit() or not 0 <= int(level) <= top:
        die(f"fan takes 0..{top} or auto")
    (d / "cur_state").write_text(level)
    return level


def cmd_timezone(tz: str) -> str:
    if not TZ_RE.match(tz) or ".." in tz or not (ZONEINFO / tz).is_file():
        die("not a time zone")
    run("timedatectl", "set-timezone", tz)
    return tz


def cmd_wifi_country(cc: str) -> str:
    if not re.fullmatch(r"[A-Z]{2}", cc):
        die("not a country code")
    run("raspi-config", "nonint", "do_wifi_country", cc)
    return cc


def cmd_lights(args: list[str]) -> str:
    """The checks run as a transient unit so this answers at once; when it
    ends (done, stopped or failed) jb-lights is started again."""
    if args == ["stop"]:
        if run("systemctl", "is-active", "--quiet", TEST_UNIT, check=False).returncode == 0:
            run("systemctl", "stop", TEST_UNIT)
        run("systemctl", "start", "jb-lights")
        return "stopped"
    if len(args) != 3 or args[0] not in ("identify", "load"):
        die("lights identify CHAIN SECONDS | load CHAINS SECONDS | stop")
    mode, chains, seconds = args
    names = chains.split(",")
    if not names or any(n not in CHAINS for n in names) or len(set(names)) != len(names) \
            or (mode == "identify" and len(names) != 1):
        die("bad chain list")
    if not seconds.isdigit() or not 1 <= int(seconds) <= 300:
        die("seconds 1..300")
    if run("systemctl", "is-active", "--quiet", TEST_UNIT, check=False).returncode == 0:
        run("systemctl", "stop", TEST_UNIT)
    run("systemctl", "reset-failed", TEST_UNIT, check=False)
    run("systemctl", "stop", "jb-lights")
    run("systemd-run", f"--unit={TEST_UNIT}", "--collect", "--no-block", "--quiet",
        f"--working-directory={REPO}", "--setenv=PYTHONDONTWRITEBYTECODE=1",
        "--property=ExecStopPost=/bin/systemctl start jb-lights",
        str(PYTHON), "-m", "services.jb_lights.wizard_test", mode, ",".join(names), "--seconds", seconds)
    return "started"


def with_field(text: str, field: str, value: str | None) -> str | None:
    """A service's config with `field` set (or removed when None); None when
    that changes nothing. Its other settings are kept."""
    data = json.loads(text) if text.strip() else {}
    if not isinstance(data, dict):
        die("the config isn't a JSON object")
    new = {k: v for k, v in data.items() if k != field}
    if value is not None:
        new[field] = value
    return None if new == data else json.dumps(new, indent=2) + "\n"


def cmd_lastfm(value: str) -> str:
    if value != "clear" and not LASTFM_KEY_RE.match(value):
        die("lastfm takes a 32-character key or clear")
    ETC.mkdir(mode=0o755, exist_ok=True)
    changed = []
    for unit, field in LASTFM_FIELDS.items():
        path = ETC / f"{unit}.json"
        text = path.read_text() if path.exists() else ""
        new = with_field(text, field, None if value == "clear" else value)
        if new is None:
            continue
        write(path, new, 0o640)
        shutil.chown(path, "root", "admin")      # the services run as admin and only read it
        changed.append(unit)
    if changed:
        # Only the ones running: the setup wizard may have turned jb-analyzer off.
        run("systemctl", "try-restart", *changed)
    return "changed" if changed else "unchanged"


def cmd_update(what: str) -> str:
    if what == "check":
        return run(UPDATE, "check", check=False).stdout.strip()
    if what in ("auto-on", "auto-off"):
        return run(UPDATE, "set-auto", what[5:]).stdout.strip()
    if what == "apply":
        if run("systemctl", "is-active", "--quiet", UPDATE_UNIT, check=False).returncode == 0 or \
                run("systemctl", "is-active", "--quiet", "jb-update", check=False).returncode == 0:
            return "already updating"
        run("systemctl", "reset-failed", UPDATE_UNIT, check=False)
        run("systemd-run", f"--unit={UPDATE_UNIT}", "--collect", "--no-block", "--quiet", UPDATE, "apply")
        return "started"
    die("update check|apply|auto-on|auto-off")


def drive_with_label(label: str) -> str | None:
    """/dev/sdX1 of the drive with this label, or None."""
    out = run("lsblk", "-rno", "PATH,LABEL", check=False).stdout
    for line in out.splitlines():
        parts = line.split(" ", 1)
        if len(parts) == 2 and parts[1].strip() == label:
            return parts[0]
    return None


class Mounted:
    """A keypad board's drive, mounted for a moment."""

    def __init__(self, device: str, write: bool = False):
        self.device, self.write = device, write

    def __enter__(self) -> Path:
        KEYPAD_MOUNTS.mkdir(mode=0o700, parents=True, exist_ok=True)
        self.path = Path(tempfile.mkdtemp(dir=KEYPAD_MOUNTS))
        opts = ("rw" if self.write else "ro") + ",nosuid,nodev,noexec"
        run("mount", "-t", "vfat", "-o", opts, self.device, str(self.path))
        return self.path

    def __exit__(self, *exc):
        os.sync()
        if run("umount", str(self.path), check=False).returncode != 0:
            run("umount", "--lazy", str(self.path), check=False)
        try:
            self.path.rmdir()
        except OSError:
            pass


def read_text(path: Path) -> str:
    try:
        return path.read_text(errors="replace")
    except OSError:
        return ""


def pico_board(info_uf2: str) -> str | None:
    """INFO_UF2.TXT's board: "RPI-RP2" for a Pico (RP2040)."""
    m = re.search(r"^Board-ID:\s*(\S+)", info_uf2, re.M)
    return m.group(1) if m else None


def our_program(config_py: str) -> tuple[bool, str | None]:
    """Is this our keypad program, and which version ("1" before versions)."""
    if "JB Keypad" not in config_py:
        return False, None
    m = PICO_VERSION_RE.search(config_py)
    return True, m.group(1) if m else "1"


def keypad_status() -> dict:
    out = {"bootloader": False, "board": None, "circuitpy": False, "ours": False, "version": None}
    dev = drive_with_label("RPI-RP2")
    if dev:
        with Mounted(dev) as root:
            out.update(bootloader=True, board=pico_board(read_text(root / "INFO_UF2.TXT")))
    dev = drive_with_label("CIRCUITPY")
    if dev:
        with Mounted(dev) as root:
            ours, version = our_program(read_text(root / "config.py"))
            out.update(circuitpy=True, ours=ours, version=version)
    return out


def copy_program(root: Path):
    lib = root / "lib" / "adafruit_hid"
    lib.mkdir(parents=True, exist_ok=True)
    for f in sorted(HID_LIB.glob("*.py")):
        shutil.copyfile(f, lib / f.name)
    for name in PROGRAM:
        shutil.copyfile(FIRMWARE / name, root / name)
    os.sync()


def pico_serial() -> str | None:
    """The keypad board's serial console (it has one in maintenance mode)."""
    by_id = Path("/dev/serial/by-id")
    found = sorted(str(p) for p in by_id.glob("*")) if by_id.is_dir() else []
    ours = [p for p in found if re.search(r"JB_Keypad|CircuitPython|Pico", p)]
    if ours:
        return ours[0]
    acm = sorted(str(p) for p in Path("/dev").glob("ttyACM*"))
    return acm[0] if len(acm) == 1 else None


def restart_pico() -> bool:
    """Restart it through its console, so boot.py runs again: a keyboard
    and nothing else. False if there was no console (unplug it and back)."""
    import termios
    import time
    import tty
    path = pico_serial()
    if not path:
        return False
    fd = os.open(path, os.O_RDWR | os.O_NOCTTY)
    try:
        tty.setraw(fd)
        termios.tcflush(fd, termios.TCIOFLUSH)
        os.write(fd, b"\x03\x03")             # stop code.py...
        time.sleep(0.5)
        os.write(fd, b"\r")                  # ...and "press any key to enter the REPL"
        time.sleep(0.8)                      # (without it, the command's first letter is that key)
        os.write(fd, b"import microcontroller; microcontroller.reset()\r")
        time.sleep(0.3)
    except OSError:
        pass                                  # it went away mid-write: restarted
    finally:
        os.close(fd)
    return True


def wait_for_label(label: str, seconds: float) -> str | None:
    import time
    end = time.monotonic() + seconds
    while time.monotonic() < end:
        run("udevadm", "settle", "--timeout=2", check=False)
        dev = drive_with_label(label)
        if dev:
            return dev
        time.sleep(1)
    return None


def put_program(dev: str, replace: bool) -> str:
    with Mounted(dev, write=True) as root:
        ours, _ = our_program(read_text(root / "config.py"))
        if not ours and not replace and (root / "code.py").exists():
            die("this board has other software on it; it's only replaced when you say so")
        copy_program(root)
    return "installed" if restart_pico() else "installed; unplug the keypad board and plug it back in"


def cmd_keypad(args: list[str]) -> str:
    what = args[0] if args else ""
    if what == "status" and len(args) == 1:
        return json.dumps(keypad_status())
    if what == "install" and len(args) == 1:
        dev = drive_with_label("RPI-RP2")
        if not dev:
            die("no keypad board waiting to be installed: hold its BOOTSEL button while you plug it in")
        with Mounted(dev, write=True) as root:
            board = pico_board(read_text(root / "INFO_UF2.TXT"))
            if board != "RPI-RP2":
                die(f"this board ({board or 'unknown'}) isn't a Raspberry Pi Pico; the keypad program is for the Pico")
            shutil.copyfile(UF2, root / UF2.name)  # it restarts into CircuitPython once it has it
        dev = wait_for_label("CIRCUITPY", CIRCUITPY_WAIT_S)
        if not dev:
            die("CircuitPython didn't start on the keypad board; unplug it and try again")
        return put_program(dev, replace=True)
    if what == "update" and args[1:] in ([], ["replace"]):
        dev = drive_with_label("CIRCUITPY")
        if not dev:
            die("the keypad board isn't showing its drive: unplug it, hold A while you plug it back in")
        return put_program(dev, replace=args[1:] == ["replace"])
    die("unknown keypad command")


def name_taken(name: str) -> bool:
    """Does another device on the network answer to NAME.local? (Avahi gives up after about 5 s.)"""
    try:
        return run(*AVAHI, "ResolveHostName", "iisiu", "--", "-1", "-1", f"{name}.local", "-1", "0",
                   check=False, timeout=10).returncode == 0
    except subprocess.TimeoutExpired:
        return False


def cmd_hostname(what: str, name: str) -> str:
    if not HOSTNAME_RE.match(name):
        die("not a network name")
    if name == run("hostname").stdout.strip():
        return name
    if name_taken(name):
        die(f"Another device on this network is already called {name}.local. Pick another name.")
    if what == "check":
        return name
    run("hostnamectl", "set-hostname", name)
    hosts = HOSTS.read_text()
    line = f"127.0.1.1\t{name}"
    hosts = re.sub(r"^127\.0\.1\.1\s.*$", line, hosts, flags=re.M) if re.search(r"^127\.0\.1\.1\s", hosts, re.M) \
        else hosts.rstrip("\n") + f"\n{line}\n"
    write(HOSTS, hosts)
    # Avahi takes the new name at once, keeping what's announced (AirPlay, the app).
    run(*AVAHI, "SetHostName", "s", name)
    return name


def dispatch(a: list[str]) -> str:
    if len(a) == 2 and a[0] == "psu":
        return cmd_psu(a[1])
    if len(a) == 2 and a[0] == "rtc-charge" and a[1] in ("on", "off"):
        if not is_pi5():
            die("the RTC battery is a Raspberry Pi 5 thing")
        return set_block_line(RTC_CHARGE, a[1] == "on")
    if len(a) == 2 and a[0] == "fan":
        return cmd_fan(a[1])
    if len(a) == 2 and a[0] == "timezone":
        return cmd_timezone(a[1])
    if len(a) == 2 and a[0] == "wifi-country":
        return cmd_wifi_country(a[1])
    if a and a[0] == "lights":
        return cmd_lights(a[1:])
    if len(a) == 2 and a[0] == "lastfm":
        return cmd_lastfm(a[1])
    if len(a) == 2 and a[0] == "update":
        return cmd_update(a[1])
    if a and a[0] == "keypad":
        return cmd_keypad(a[1:])
    if len(a) == 3 and a[0] == "hostname" and a[1] in ("check", "set"):
        return cmd_hostname(a[1], a[2])
    die("unknown command")


def serve():
    RESPONSES.mkdir(parents=True, exist_ok=True)
    shutil.chown(RESPONSES, "admin", "admin")
    for req in sorted(REQUESTS.glob("*.json")) if REQUESTS.is_dir() else []:
        answer = {"ok": False, "out": "", "error": ""}
        try:
            if not REQ_NAME_RE.match(req.name) or req.is_symlink():
                raise Refused("bad request file")
            body = json.loads(req.read_text())
            verb, args = body.get("verb"), body.get("args", [])
            if not isinstance(verb, str) or not isinstance(args, list) or not all(isinstance(x, str) for x in args):
                raise Refused("bad request")
            answer["out"] = dispatch([verb, *args])
            answer["ok"] = True
        except Refused as e:
            answer["error"] = str(e)
        except subprocess.CalledProcessError as e:
            answer["error"] = f"{' '.join(e.cmd[:3])} failed: {(e.stderr or '').strip()[-300:]}"
        except (ValueError, OSError) as e:
            answer["error"] = str(e)
        finally:
            req.unlink(missing_ok=True)
        if REQ_NAME_RE.match(req.name):
            path = RESPONSES / req.name
            write(path, json.dumps(answer))
            shutil.chown(path, "admin", "admin")


def main():
    if os.geteuid() != 0:
        print("jb-setupctl: must run as root", file=sys.stderr)
        sys.exit(2)
    a = sys.argv[1:]
    try:
        if a == ["serve"]:
            serve()
        else:
            print(dispatch(a))
    except Refused as e:
        print(f"jb-setupctl: {e}", file=sys.stderr)
        sys.exit(2)
    except subprocess.CalledProcessError as e:
        print(f"jb-setupctl: {' '.join(e.cmd)} failed: {(e.stderr or '').strip()[-300:]}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
