# Juk3box's AirPlay receiver (shairport-sync, deploy/airplay/): AirPlay 2
# (our build, with jb-nqptp's clock) when it can run, else Raspberry Pi OS's
# classic one; deploy/airplay/jb-airplay chooses. Runs as admin so it plays
# into admin's PipeWire, like everything else; the Debian package's own
# system service is disabled (it would grab the ALSA device).
# Install: deploy/install/install.sh
[Unit]
Description=juk3-box AirPlay receiver (shairport-sync)
After=network-online.target avahi-daemon.service jb-nqptp.service
Wants=avahi-daemon.service jb-nqptp.service

[Service]
Type=simple
User=admin
Environment=XDG_RUNTIME_DIR=/run/user/1000
# The speaker's name: the admin's Sources > App, written by jb-source-helper
# (the jukebox's name in the app too); the config's name until it's set.
EnvironmentFile=-/var/lib/juk3-box/helper/airplay.env
ExecStart=/usr/local/sbin/jb-airplay
# As root: notes an AirPlay 2 failure, so the next start is classic.
ExecStopPost=+/usr/local/sbin/jb-airplay --stopped
# /run/jb-airplay/ap2: "AirPlay 2 is what's running" (jb-airplay --stopped).
RuntimeDirectory=jb-airplay
# Ahead of the kiosk, the lights and the analyzer: at their default
# priority shairport-sync's threads waited behind them on the Pi 4 and the
# app's music glitched (2026-10-20, the same as jb-audio's realtime fix).
Nice=-10
LimitRTPRIO=95
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
