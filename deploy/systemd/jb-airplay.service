# JUKE.BOX's AirPlay receiver (shairport-sync, deploy/airplay/). Runs as
# admin so it plays into admin's PipeWire, like everything else; the Debian
# package's own system service is disabled (it would grab the ALSA device).
# Install: deploy/airplay/install.sh
[Unit]
Description=juk3-box AirPlay receiver (shairport-sync)
After=network-online.target avahi-daemon.service
Wants=avahi-daemon.service

[Service]
Type=simple
User=admin
Environment=XDG_RUNTIME_DIR=/run/user/1000
# The speaker's name: the admin's Sources > App, written by jb-source-helper
# (the jukebox's name in the app too); the config's name until it's set.
EnvironmentFile=-/var/lib/juk3-box/helper/airplay.env
ExecStart=/bin/sh -c 'exec /usr/bin/shairport-sync -c /opt/juk3-box/deploy/airplay/shairport-sync.conf $${JB_AIRPLAY_NAME:+-a "$$JB_AIRPLAY_NAME"}'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
