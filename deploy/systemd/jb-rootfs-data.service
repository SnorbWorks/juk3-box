# The first start of a card made from the Juk3box image: the data partition
# (deploy/jb-rootfs make-data), before anything uses the folders it takes
# over; then the jukebox restarts once. (The setup wizard's Finish protects
# the system.)
[Unit]
Description=juk3-box data partition (first start)
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target systemd-journal-flush.service
ConditionPathExists=/etc/juk3-box/make-data-partition

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/jb-rootfs make-data
TimeoutStartSec=10min

[Install]
WantedBy=sysinit.target
