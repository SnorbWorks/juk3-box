# Nightly, between 3:30 and 4:30 (each jukebox picks its own minute), or
# within the hour after the next start if it was off then. A protected
# system (deploy/jb-rootfs) forgets the last run when it restarts, so that's
# within the hour after nearly every start.
[Unit]
Description=juk3-box nightly update check

[Timer]
OnCalendar=*-*-* 03:30
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
