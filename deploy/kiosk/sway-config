# Minimal kiosk config: one fullscreen Chromium, no cursor, no chrome.
# Installed on the Pi as ~admin/.config/sway/config (see README.md).
seat * hide_cursor 1

# The Juk3box splash while Chromium starts (it takes ~10 s on a Pi 4); the
# page shows the same picture until its screen is ready.
output * bg /opt/juk3-box/services/jb_ui/engine/splash.png fill #7a3db0

# In --app mode Chromium's Wayland app_id is "chrome-<url>-Default", not
# "chromium" -- match both.
# Opacity 0: the window opens see-through, so the splash wallpaper shows
# until the page has painted its own copy of it; the launcher then makes
# it opaque (kiosk-chromium.sh).
for_window [app_id="^chrom"] fullscreen enable, border none, opacity 0

# Launcher resets Chromium crash state and starts in app mode (no browser UI flash).
exec /opt/juk3-box/deploy/kiosk/kiosk-chromium.sh
