#!/usr/bin/python3
"""jb-update: a jukebox updates itself from the project's GitHub releases.

    jb-update check          is there a newer version? (writes the state)
    jb-update apply          install the newest version now
    jb-update auto           what the nightly timer runs: check, queue the
                             downloads, and install (which restarts) when the
                             owner left "update automatically" on and nothing
                             is playing -- else the queued update waits
    jb-update boot           what jb-update-boot runs at every start, before
                             any source: install whatever auto queued, while
                             nothing is playing yet (the "install on restart")
    jb-update set-auto on|off
    jb-update os-check       which Raspberry Pi OS packages have updates (security ones apart)
    jb-update os-apply security|all
                             install them: the security fixes, or everything
    jb-update resume         after restarting without protection to install (below)

latest.json on the newest release names the code bundle and its signature.
The bundle is installed only if it's signed with the key this jukebox
already has (deploy/update/juk3box-update.pub, from its current version),
and only if it's newer. The new code goes to /opt/juk3-box and the old one
stays beside it (/opt/juk3-box.prev) with the Python packages moved over;
then the installer runs (packages, services) and the jukebox restarts. If
its services don't all come back, the old version goes back in.

Raspberry Pi OS is updated here too (the admin's Updates tab), in the
state's "os": security fixes (Debian's -security suite) automatically
each night when updates are automatic, everything else only when the owner
asks (Chromium, the kernel and firmware are where a jukebox could break).
Some packages only take effect on a restart: "restart_needed", which the
admin acts on overnight when nothing is playing.

An install always restarts (a protected system, below), so it never runs
while a song is playing: auto queues the download but holds the restart
back, and jb-update-boot installs at the next start, before any source can
play.  The screen says "Installing updates" (NOTICE_TOPIC) before the
restart and clears it once a start finds nothing left to install.  One
operation at a time: a file lock (DIR/lock) serialises auto, boot, resume,
Update now and the OS installs, so a start that's installing a queued update
can't collide with a fresh check.

On a protected system (deploy/jb-rootfs: the system drive read-only
behind an overlay) nothing installed would survive a restart, so apply
and os-apply instead note what to install (RESUME), turn the protection
off for one start and restart; jb-update-resume.service installs it then,
turns the protection back on and restarts again. Checking for OS updates
keeps apt's lists on the data partition, not in memory.

The state's "phase" is the step under way (starting, to install,
downloading, checking, installing, restarting, rolling back, protecting),
with "phase_at", when it began: the admin shows it on the Update now
button, and takes a step from before the last restart as over unless a
restart to install is still to come (resume.json).

A copy without /opt/juk3-box/VERSION is a developer's (deploy.sh): it's
never updated from here. Runs as root: from the timer (jb-update.timer),
or jb-setupctl's "update" requests (the admin's Updates card). Never two
at once (each would install over the other's files): the nightly run
leaves it to the next night when another is under way, and jb-setupctl
doesn't start one beside it.
"""

import contextlib
import fcntl
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
import time
import urllib.request
from pathlib import Path

LATEST_URL = "https://github.com/SnorbWorks/juk3-box/releases/latest/download/latest.json"
REPO = Path("/opt/juk3-box")
PREV = Path("/opt/juk3-box.prev")
NEW = Path("/opt/juk3-box.new")
DIR = Path("/var/lib/juk3-box/update")
STATE = DIR / "state.json"
SETTINGS = DIR / "settings.json"
KEY = "deploy/update/juk3box-update.pub"
UNITS = ["jb-admin", "jb-analyzer", "jb-core", "jb-display", "jb-input", "jb-library", "jb-source-helper",
         "jb-source-local", "jb-source-phone", "jb-ui", "jb-audio", "jb-crawl", "jb-lights", "jb-netwatch",
         "jb-airplay"]
SETTLE_S = 45                 # how long the services get to come back before it's judged
TIMEOUT_S = 60
VERSION_RE = re.compile(r"^v(\d+)\.(\d+)\.(\d+)$")
# "name/suite[,suite] version arch [upgradable from: old]" (apt list --upgradable)
UPGRADABLE_RE = re.compile(r"^([^/\s]+)/(\S+) (\S+) \S+ \[upgradable from: ([^\]]+)\]")
# Packages that only take effect on a restart.
# APT::Status-Fd: "pmstatus:libc6:arm64:40.0000:Installing libc6 (arm64)" (the
# package may carry its arch; the message may hold colons).
STATUS_RE = re.compile(r"^(dlstatus|pmstatus):(.+?):(\d+(?:\.\d+)?):(.*)$")
RESTART_RE = re.compile(r"^(linux-image|linux-headers|raspi-firmware|rpi-eeprom|raspberrypi-sys-mods|libc6|systemd|dbus)")
RESUME = DIR / "resume.json"
# The kiosk launcher reads this at boot to show "Installing update" instead of
# a blank wait while jb-ui is still down (notice() writes it; on the data
# partition, so it survives the reboot the retained MQTT notice doesn't).
KIOSK_FLAG = DIR / "kiosk.json"
ROOTFS = "/usr/local/sbin/jb-rootfs"
# The other updates: the admin's Update now and Raspberry Pi OS installs
# (deploy/jb-setupctl), and the install after a restart to install.
OTHER_UNITS = ("jb-update-now", "jb-update-os", "jb-update-resume", "jb-update-boot")
APT_DATA = Path("/data/cache/apt")       # apt's lists and downloads while protected
APT_OPTS = ("-y", "-q", "-o", "DPkg::Lock::Timeout=300",
            "-o", "Dpkg::Options::=--force-confdef", "-o", "Dpkg::Options::=--force-confold")


class Failed(Exception):
    pass


class Busy(Exception):
    """Another update operation holds the lock."""
    pass


def version_key(v) -> tuple | None:
    m = VERSION_RE.match(v or "")
    return tuple(int(x) for x in m.groups()) if m else None


def newer(latest, current) -> bool:
    a, b = version_key(latest), version_key(current)
    return a is not None and b is not None and a > b


def current_version(root: Path = REPO) -> str | None:
    try:
        v = (root / "VERSION").read_text().strip()
    except OSError:
        return None
    return v if version_key(v) else None


def read_json(path: Path, default):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return default


def write_json(path: Path, data) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
    with os.fdopen(fd, "w") as f:
        json.dump(data, f, indent=2)
    os.chmod(tmp, 0o644)              # jb-admin (not root) reads it
    os.replace(tmp, path)


def state(**changes) -> dict:
    s = read_json(STATE, {})
    s.update(changes)
    write_json(STATE, s)
    return s


def set_phase(name, **changes) -> dict:
    """The step under way (None: none), and since when, for the admin."""
    return state(phase=name, phase_at=time.time(), **changes)


def os_phase(name, **changes) -> dict:
    return os_state(phase=name, phase_at=time.time(), **changes)


def auto_on() -> bool:
    return read_json(SETTINGS, {}).get("auto", True) is not False


NOW_PLAYING_TOPICS = ("jukebox/jb-source-phone/now-playing",
                      "jukebox/jb-source-local/now-playing",
                      "jukebox/jb-source-helper/now-playing")
NOTICE_TOPIC = "jukebox/jb-update/installing"
NOTICE_PAUSE_S = 3            # the screen gets this long to show the install notice before the reboot


def playing() -> bool:
    """A song playing from any source, read from the bus's retained
    now-playing (the admin's quiet() watches the same sources).  Can't tell
    (no broker, no mosquitto_sub) -> not playing: an install is never blocked
    forever by something being unreadable, and the install only runs at a
    boot or overnight anyway, where quiet is the normal case."""
    for topic in NOW_PLAYING_TOPICS:
        try:
            r = run("mosquitto_sub", "-t", topic, "-C", "1", "-W", "1", check=False)
        except OSError:
            return False
        try:
            if json.loads(r.stdout or "{}").get("status") == "playing":
                return True
        except (ValueError, TypeError):
            pass
    return False


def notice(text: str | None) -> None:
    """What the screen shows about the install: a line before the restart,
    cleared once it's done.  Best-effort: the update never waits on it.
    Two places, because the message has to outlive the restart to install:
    - retained MQTT (NOTICE_TOPIC), for a running jb-ui / engine page;
    - a file on the data partition (KIOSK_FLAG), which the kiosk launcher
      reads at the next boot -- the retained message doesn't survive a
      protected reboot (mosquitto keeps its store on the overlay).
    boot_run() clears both on every normal start."""
    try:
        if text is None:
            run("mosquitto_pub", "-t", NOTICE_TOPIC, "-r", "-n", check=False)
        else:
            run("mosquitto_pub", "-t", NOTICE_TOPIC, "-r", "-m",
                json.dumps({"text": text, "at": time.time()}), check=False)
    except OSError:
        pass
    try:
        if text is None:
            KIOSK_FLAG.unlink(missing_ok=True)
        else:
            write_json(KIOSK_FLAG, {"text": text, "at": time.time()})
    except OSError:
        pass


@contextlib.contextmanager
def locked():
    """Only one update operation at a time (the nightly check, the install at
    a boot, the admin's Update now, resume): each would install over the
    other's files.  Can't get the lock -> another holds it; the caller skips."""
    DIR.mkdir(parents=True, exist_ok=True)
    f = open(DIR / "lock", "w")
    try:
        fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        f.close()
        raise Busy("another update is under way")
    try:
        yield
    finally:
        fcntl.flock(f, fcntl.LOCK_UN)
        f.close()


def under_way(unit: str) -> bool:
    """A oneshot unit (jb-update-resume) is "activating" until it's done,
    which systemctl is-active doesn't count as active."""
    return run("systemctl", "is-active", unit, check=False).stdout.strip() in \
        ("active", "activating", "deactivating", "reloading")


def fetch(url: str, dest: Path | None = None) -> bytes | None:
    req = urllib.request.Request(url, headers={"User-Agent": "juk3box-update"})
    with urllib.request.urlopen(req, timeout=TIMEOUT_S) as r:
        if dest is None:
            return r.read()
        with open(dest, "wb") as f:
            shutil.copyfileobj(r, f)
    return None


def run(*cmd, check=True, **kw):
    return subprocess.run(cmd, check=check, capture_output=True, text=True, **kw)


# A protected system ----------------------------------------------------------

def protected(proc_cmdline: str | None = None) -> bool:
    """Started behind the overlay (deploy/jb-rootfs)."""
    text = Path("/proc/cmdline").read_text() if proc_cmdline is None else proc_cmdline
    return re.search(r"(^|\s)overlayroot=", text) is not None


def apt_dirs() -> tuple:
    """While protected, apt keeps its lists and downloads on the data
    partition (in memory they'd take a good part of the RAM)."""
    if not protected():
        return ()
    for d in (APT_DATA / "lists" / "partial", APT_DATA / "archives" / "partial"):
        d.mkdir(parents=True, exist_ok=True)
    return ("-o", f"Dir::State::Lists={APT_DATA / 'lists'}", "-o", f"Dir::Cache={APT_DATA}")


def restart_to_install(verbs: list[list[str]]) -> None:
    """Note what to install, start once without protection, restart. The
    steps say "to install" first (the restart can come at once); if it
    can't restart, the protection stays as it was and they say why."""
    os_verb = next((v for v in verbs if v[:1] == ["os-apply"]), None)
    if ["apply"] in verbs:
        set_phase("to install", error=None)
    if os_verb:
        os_phase("to install", what=os_verb[1], error=None, queue=[])
    write_json(RESUME, {"verbs": verbs, "at": time.time()})
    off = False
    try:
        notice("Installing updates. The jukebox will restart.")
        time.sleep(NOTICE_PAUSE_S)     # a moment for the screen to show it before the reboot
        run(ROOTFS, "off")
        off = True
        run("systemctl", "--no-block", "reboot")
    except (subprocess.SubprocessError, OSError) as e:
        RESUME.unlink(missing_ok=True)
        notice(None)                   # the restart didn't happen: don't leave "will restart" up
        if off:
            run(ROOTFS, "on", check=False)
        error = f"Couldn't restart to install: {e}"
        if ["apply"] in verbs:
            set_phase(None, error=error)
        if os_verb:
            os_phase(None, error=error)


def resume() -> dict:
    """The start without protection: install what was noted, protect the
    system again, restart. The note goes first, so a failure can't loop."""
    note = read_json(RESUME, {})
    verbs = (note.get("verbs") if isinstance(note, dict) else None) or []
    s = {}
    try:
        try:
            # Under way again, from this start, before the note goes: in between, the
            # admin would take the "to install" from before the restart as over.
            if ["apply"] in verbs:
                set_phase("starting", error=None)
            if any(v[:1] == ["os-apply"] for v in verbs):
                os_phase("starting", error=None)
        finally:
            RESUME.unlink(missing_ok=True)
        if any(v[:1] == ["os-apply"] for v in verbs):
            # Fresh apt lists on the real system drive before installing. The
            # check that queued this kept its lists on the data partition
            # (apt_dirs, while protected); unprotected now, apt reads the
            # normal lists, so without this upgradable() finds nothing and the
            # install never lands (and the queued state would keep re-trying).
            run("apt-get", "update", "-q", "-o", "DPkg::Lock::Timeout=300", check=False, timeout=900)
        for verb in verbs:
            if verb == ["apply"]:
                s = apply(then="protecting")
            elif len(verb) == 2 and verb[0] == "os-apply" and verb[1] in ("security", "all"):
                s = {"os": os_apply(verb[1])}
    finally:
        try:
            # Until the restart that protects the system again (the admin takes it as over after it).
            if ["apply"] in verbs:
                set_phase("protecting")
            if any(v[:1] == ["os-apply"] for v in verbs):
                os_phase("protecting")
        finally:
            run(ROOTFS, "on", check=False)
            run("systemctl", "--no-block", "reboot", check=False)
    return s


# Checking --------------------------------------------------------------------

def check() -> dict:
    current = current_version()
    if current is None:
        return state(current=None, latest=None, available=False, checked_at=time.time(),
                     error=None, note="A development copy: it's updated by deploying, not from releases.")
    try:
        latest = json.loads(fetch(LATEST_URL))
    except Exception as e:          # offline, GitHub down, no release yet
        return state(current=current, checked_at=time.time(), error=f"Couldn't check for updates: {e}")
    v = latest.get("version")
    if not version_key(v):
        return state(current=current, checked_at=time.time(), error="The release list didn't make sense.")
    return state(current=current, latest=v, latest_date=latest.get("date"), available=newer(v, current),
                 checked_at=time.time(), error=None, note=None, release=latest)


# Applying --------------------------------------------------------------------

def verify(bundle: Path, sig: Path, sha256: str, key: Path) -> None:
    h = hashlib.sha256(bundle.read_bytes()).hexdigest()
    if h != sha256:
        raise Failed("The download doesn't match the release (checksum).")
    r = run("openssl", "pkeyutl", "-verify", "-pubin", "-inkey", str(key), "-rawin",
            "-in", str(bundle), "-sigfile", str(sig), check=False)
    if r.returncode != 0:
        raise Failed("The update isn't signed with this jukebox's key: not installed.")


def unpack(bundle: Path, dest: Path) -> None:
    shutil.rmtree(dest, ignore_errors=True)
    dest.mkdir(parents=True)
    with tarfile.open(bundle, "r:gz") as t:
        t.extractall(dest, filter="data")     # no paths outside dest, no device files


def services(action: str) -> None:
    run("systemctl", action, *[f"{u}.service" for u in UNITS], check=False)


def failed_units() -> list[str]:
    out = []
    for u in UNITS:
        if run("systemctl", "is-enabled", "--quiet", f"{u}.service", check=False).returncode != 0:
            continue                          # turned off on purpose (the setup wizard's suggestions)
        if run("systemctl", "is-active", "--quiet", f"{u}.service", check=False).returncode != 0:
            out.append(u)
    return out


def install(root: Path) -> None:
    r = run("sh", str(root / "deploy/install/install.sh"), check=False, timeout=3600)
    if r.returncode != 0:
        raise Failed("The installer stopped: " + (r.stderr or r.stdout).strip()[-400:])


def swap_in(new: Path) -> None:
    """new -> /opt/juk3-box, the running one -> .prev, the Python packages with it."""
    shutil.rmtree(PREV, ignore_errors=True)
    os.rename(REPO, PREV)
    os.rename(new, REPO)
    if (PREV / "venv").is_dir():
        os.rename(PREV / "venv", REPO / "venv")


def swap_back() -> None:
    broken = REPO.with_name("juk3-box.failed")
    shutil.rmtree(broken, ignore_errors=True)
    if (REPO / "venv").is_dir():
        os.rename(REPO / "venv", PREV / "venv")
    os.rename(REPO, broken)
    os.rename(PREV, REPO)


def apply(then=None) -> dict:
    """Install the newest version. then: the step to end on when installed
    ("protecting": resume's restart is still to come)."""
    set_phase("starting", error=None)
    try:
        return _apply(then)
    except Exception as e:          # whatever it was, the admin mustn't show it as still going
        set_phase(None, error=f"The update stopped: {e}")
        raise


def _apply(then=None) -> dict:
    s = check()
    if not s.get("available"):
        return set_phase(None)
    if protected():
        restart_to_install([["apply"]])
        return read_json(STATE, {})
    current, latest, rel = s["current"], s["latest"], s["release"]
    set_phase("downloading", started_at=time.time(), error=None)
    work = DIR / "download"
    shutil.rmtree(work, ignore_errors=True)
    work.mkdir(parents=True)
    try:
        bundle, sig = work / "code.tar.gz", work / "code.tar.gz.sig"
        fetch(rel["code"], bundle)
        fetch(rel["signature"], sig)
        set_phase("checking")
        verify(bundle, sig, rel.get("code_sha256", ""), REPO / KEY)
        unpack(bundle, NEW)
        if current_version(NEW) != latest:
            raise Failed(f"The download says it's {current_version(NEW)}, not {latest}.")
    except Failed as e:
        shutil.rmtree(NEW, ignore_errors=True)
        return set_phase(None, error=str(e))
    except Exception as e:
        shutil.rmtree(NEW, ignore_errors=True)
        return set_phase(None, error=f"Couldn't download the update: {e}")
    finally:
        shutil.rmtree(work, ignore_errors=True)

    set_phase("installing")
    swap_in(NEW)
    # Called from resume (then="protecting")?  resume re-protects and reboots
    # the moment this returns, and that reboot starts every service fresh on
    # the new version.  Restarting them here would hang the whole cabinet:
    # this runs inside jb-update-resume.service, which the boot
    # (multi-user.target) is waiting on, so a synchronous `systemctl restart`
    # of the boot's own services never completes -- v0.3.5's install wedged
    # exactly this way (jb-core/jb-ui stuck dead, admin and kiosk frozen).
    # So when a reboot follows, skip the in-place restart and the start check;
    # the reboot does the restart, and a service that won't start shows up on
    # the next boot.  The direct path (Update now on an already-unprotected
    # system) still restarts and rolls back here, where it's safe.
    reboot_follows = then == "protecting"
    try:
        install(REPO)
        run("systemctl", "daemon-reload")
        if not reboot_follows:
            set_phase("restarting")
            services("restart")
            time.sleep(SETTLE_S)
            bad = failed_units()
            if bad:
                raise Failed("These didn't start on the new version: " + ", ".join(bad))
    except (Failed, subprocess.SubprocessError, OSError) as e:
        set_phase("rolling back")
        swap_back()
        try:
            install(REPO)
        except Failed:
            pass
        run("systemctl", "daemon-reload", check=False)
        if not reboot_follows:
            services("restart")
        return set_phase(None, current=current, available=True,
                         error=f"{latest} didn't work here, so {current} is back. {e}")
    return set_phase(then, current=latest, available=False, updated_at=time.time(),
                     updated_from=current, error=None)


# Raspberry Pi OS ---------------------------------------------------------------

def os_state(**changes) -> dict:
    s = read_json(STATE, {})
    s["os"] = {**(s.get("os") or {}), **changes}
    write_json(STATE, s)
    return s["os"]


def parse_upgradable(text: str) -> tuple[list, list]:
    """(security, other): each {"name", "from", "to"}."""
    security, other = [], []
    for line in text.splitlines():
        m = UPGRADABLE_RE.match(line.strip())
        if not m:
            continue
        name, suites, new, old = m.groups()
        pkg = {"name": name, "from": old, "to": new}
        (security if any(x.endswith("-security") for x in suites.split(",")) else other).append(pkg)
    return security, other


def upgradable() -> tuple[list, list]:
    return parse_upgradable(run("apt", *apt_dirs(), "list", "--upgradable", check=False).stdout)


def os_check() -> dict:
    r = run("apt-get", *apt_dirs(), "update", "-q", "-o", "DPkg::Lock::Timeout=300", check=False, timeout=900)
    security, other = upgradable()
    error = None if r.returncode == 0 else \
        "Couldn't reach Raspberry Pi OS's servers: " + (r.stderr or r.stdout).strip()[-300:]
    return os_state(checked_at=time.time(), security=security, other=other, error=error)


class Progress:
    """apt's status lines (APT::Status-Fd) into the queue the admin shows:
    each package waiting, running, done; and the download as a whole.

      dlstatus:<n>:<percent>:<message>
      pmstatus:<package>:<percent>:<message>      ...  "Installed <package>" when it's done

    A package is "running" from apt's first word about it until "Installed";
    apt unpacks several before setting them up, so the newest one mentioned
    is the one shown running."""

    def __init__(self, names: list[str]):
        self.queue = [{"name": n, "state": "waiting"} for n in names]
        self.by_name = {q["name"]: q for q in self.queue}
        self.download = 0

    def line(self, line: str) -> bool:
        """True when what's shown changed."""
        m = STATUS_RE.match(line.rstrip("\n"))
        if not m:
            return False
        kind, name, percent, message = m.group(1), m.group(2).split(":")[0], float(m.group(3)), m.group(4)
        if kind == "dlstatus":
            step = int(percent // 5) * 5
            changed, self.download = step != self.download, step
            return changed
        q = self.by_name.get(name)          # "dpkg-exec" and the like aren't in it
        if q is None or q["state"] == "done":
            return False
        if message.startswith("Installed "):
            q["state"] = "done"
            return True
        if q["state"] != "running":
            for other in self.queue:
                if other["state"] == "running":
                    other["state"] = "unpacked"     # set up later in the run
            q["state"] = "running"
            return True
        return False

    def view(self) -> list[dict]:
        # "unpacked" waits its turn to be set up: shown as waiting.
        return [{"name": q["name"], "state": "waiting" if q["state"] == "unpacked" else q["state"]} for q in self.queue]


def os_apply(which: str) -> dict:
    try:
        return _os_apply(which)
    except Exception as e:          # as apply(): never left looking as if it's still going
        os_phase(None, error=f"The update stopped: {e}")
        raise


def _os_apply(which: str) -> dict:
    security, other = upgradable()
    chosen = security if which == "security" else security + other
    if not chosen:
        return os_phase(None, security=security, other=other)
    if protected():
        restart_to_install([["os-apply", which]])
        return read_json(STATE, {}).get("os") or {}
    progress = Progress([p["name"] for p in chosen])
    os_phase("installing", what=which, error=None, queue=progress.view(), download=0)
    env = {**os.environ, "DEBIAN_FRONTEND": "noninteractive", "APT_LISTCHANGES_FRONTEND": "none"}
    status_r, status_w = os.pipe()
    opts = (*APT_OPTS, "-o", f"APT::Status-Fd={status_w}")
    if which == "security":
        cmd = ("apt-get", *opts, "install", "--only-upgrade", *[p["name"] for p in chosen])
    else:
        cmd = ("apt-get", *opts, "upgrade", "--with-new-pkgs")
    with tempfile.TemporaryFile("w+") as log:
        proc = subprocess.Popen(cmd, stdout=log, stderr=subprocess.STDOUT, env=env, pass_fds=(status_w,), text=True)
        os.close(status_w)
        with os.fdopen(status_r) as status:
            for line in status:
                if progress.line(line):
                    os_state(queue=progress.view(), download=progress.download)
        code = proc.wait()
        log.seek(0)
        output = log.read()
    security, other = upgradable()
    queue = progress.view()
    if code != 0:
        for q in queue:
            if q["state"] == "running":
                q["state"] = "failed"
        return os_phase(None, security=security, other=other, queue=queue,
                        error="The update stopped: " + output.strip()[-300:])
    left = {p["name"] for p in security + other}
    for q in queue:             # apt had nothing to do for some (pulled in by another): done
        if q["state"] != "done" and q["name"] not in left:
            q["state"] = "done"
    # Everything (Chromium, PipeWire...) takes effect on a restart too.
    restart = which == "all" or Path("/run/reboot-required").exists() or \
        any(RESTART_RE.match(p["name"]) for p in chosen)
    changes = {"security": security, "other": other, "updated_at": time.time(),
               "updated": [p["name"] for p in chosen], "error": None, "queue": queue}
    if restart:
        changes["restart_needed_at"] = time.time()
    return os_phase(None, **changes)


def pending_verbs(s: dict) -> list[list]:
    """What the saved state says is queued to install: a newer Juk3box, and
    the Raspberry Pi OS security fixes found but not yet installed."""
    security = (s.get("os") or {}).get("security") or []
    return ([["apply"]] if s.get("available") else []) + ([["os-apply", "security"]] if security else [])


def auto_run() -> dict:
    """The nightly/after-a-start timer: check, queue the downloads, and
    install (which restarts) when automatic updates are on and nothing is
    playing.  Queuing (the download) is never held back; a queued update it
    can't install now waits for jb-update boot at the next start, or the next
    quiet run."""
    if not auto_on():                   # automatic updates off: look, never install
        s = check()
        os_check()
        return s
    if not protected():                 # not protected: install in place, no restart
        s = apply()
        os_check()
        os_apply("security")
        return s
    s = check()                         # protected: queue, then restart once to install
    os_check()
    security, _ = upgradable()
    verbs = ([["apply"]] if s.get("available") else []) + ([["os-apply", "security"]] if security else [])
    if verbs and not playing():         # both in one start without protection, not a restart each
        restart_to_install(verbs)
        return read_json(STATE, {})
    return s


def boot_run() -> dict:
    """What jb-update-boot runs at every start, before any source can play:
    install whatever auto already queued -- read from the saved state, so a
    start with nothing queued does no network and doesn't hold the jukebox up.
    The install itself clears the queued state (resume's fresh check finds
    nothing left), so this can't loop.  A normal start clears the screen's
    install notice; the install sets it again if it restarts."""
    notice(None)
    if not auto_on() or not protected():
        return read_json(STATE, {})
    s = read_json(STATE, {})
    verbs = pending_verbs(s)
    if verbs and not playing():
        restart_to_install(verbs)
        return read_json(STATE, {})
    return s


def main():
    if os.geteuid() != 0:
        print("jb-update: must run as root", file=sys.stderr)
        sys.exit(2)
    a = sys.argv[1:]
    DIR.mkdir(parents=True, exist_ok=True)
    os.chmod(DIR, 0o755)
    # Looking only (no files change): no lock needed.
    if a == ["check"]:
        s = check()
    elif a == ["os-check"]:
        s = os_check()
    elif len(a) == 2 and a[0] == "set-auto" and a[1] in ("on", "off"):
        write_json(SETTINGS, {"auto": a[1] == "on"})
        s = {"auto": a[1] == "on"}
    elif a in (["apply"], ["auto"], ["boot"], ["resume"]) or \
            (len(a) == 2 and a[0] == "os-apply" and a[1] in ("security", "all")):
        # Installing: one at a time (each would install over another's files).
        try:
            with locked():
                if a == ["apply"]:
                    s = apply()
                elif a == ["auto"]:
                    if any(under_way(u) for u in OTHER_UNITS):
                        print("jb-update: another update is under way; this one waits for the next night")
                        sys.exit(0)
                    s = auto_run()
                elif a == ["boot"]:
                    s = boot_run()
                elif a == ["resume"]:
                    s = resume()
                else:
                    s = os_apply(a[1])
        except Busy:
            print("jb-update: another update is under way; this one skips")
            sys.exit(0)
    else:
        print(__doc__, file=sys.stderr)
        sys.exit(2)
    print(json.dumps({k: v for k, v in s.items() if k != "release"}))
    sys.exit(1 if s.get("error") else 0)


if __name__ == "__main__":
    main()
