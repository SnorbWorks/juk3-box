      "tree": {
        "class": "jb-u-grid-2",
        "children": [
          {
            "block": "section",
            "type": "featured-artist"
          },
          {
            "block": "section",
            "type": "new",
            "limit": 2
          }
        ]
      }
    },
    {
      "label": "Two columns",
      "detail": "Side by side, anything inside",
      "icon": "columns-3",
      "tree": {
        "class": "jb-u-grid-2",
