    "section": {
      "label": "Card row",
      "group": "music",
      "icon": "rows",
      "description": "A row of song or link cards. Song cards play when clicked; link cards open the board. Fewer cards across in a narrow space.",
      "presets": [
        {
          "label": "New songs",
          "values": {
            "type": "new",
            "limit": 2
          }
        },
        {
          "label": "Featured",
          "values": {
            "type": "featured-artist"
          }
        },
        {
          "label": "Browse",
          "values": {
            "type": "browse",
            "sorts": "artist,album,top-100,most-played"
          }
        },
        {
          "label": "Playlists",
          "values": {
            "type": "playlists",
            "limit": 12
          }
        },
        {
          "label": "Recents",
          "values": {
            "type": "recents",
            "limit": 18
          }
        }
      ],
      "settings": {
        "type": {
          "type": "enum",
          "label": "Shows",
          "required": true,
          "options": [
            {
              "value": "new",
              "label": "New songs"
            },
            {
              "value": "recents",
              "label": "Recently played"
            },
            {
              "value": "featured-artist",
              "label": "Featured"
            },
            {
              "value": "playlists",
              "label": "Playlists"
            },
            {
              "value": "browse",
              "label": "Browse shortcuts"
            }
          ]
        },
        "feature": {
          "type": "enum",
          "label": "Feature",
          "default": "artist",
          "only_when": {
            "type": "featured-artist"
          },
          "options": [
            {
              "value": "artist",
              "label": "Artist"
            },
            {
              "value": "album",
              "label": "Album"
            },
            {
              "value": "genre",
              "label": "Genre"
            },
            {
              "value": "playlist",
              "label": "Playlist"
            }
          ]
        },
        "from": {
          "type": "enum",
          "label": "Pick from",
          "default": "any",
          "only_when": {
            "type": "featured-artist"
          },
          "help": "The heading follows: \"Featured Artist\", \"Most Played Album\", \"New Artist\"...",
          "options": [
            {
              "value": "any",
              "label": "Any, at random"
            },
            {
              "value": "most-played",
              "label": "Most played here"
            },
            {
              "value": "recently-added",
              "label": "Recently added"
            },
            {
              "value": "recently-played",
              "label": "Recently played"
            },
            {
              "value": "pinned",
              "label": "One I choose"
            }
          ]
        },
        "pin": {
          "type": "library",
          "label": "Show",
          "field_from": "feature",
          "only_when": {
            "type": "featured-artist",
            "from": "pinned"
          },
          "help": "Start typing to pick from your library."
        },
        "every": {
          "type": "enum",
          "label": "Change it",
          "default": "30",
          "only_when": {
            "type": "featured-artist"
          },
          "options": [
            {
              "value": "15",
              "label": "Every 15 minutes"
            },
            {
              "value": "30",
              "label": "Every 30 minutes"
            },
            {
              "value": "60",
              "label": "Every hour"
            },
            {
              "value": "240",
              "label": "Every 4 hours"
            },
            {
              "value": "1440",
              "label": "Every day"
            },
            {
              "value": "0",
              "label": "Never"
            }
          ],
          "help": "Never: the top one of the list stays (or one at random, for Any) until the list changes."
        },
        "repeats": {
          "type": "bool",
          "label": "Allow repeats",
          "default": false,
          "only_when": {
            "type": "featured-artist"
          },
          "help": "Off: one doesn't come back until the last 10 have had a turn."
        },
        "title": {
          "type": "text",
          "label": "Title",
          "help": "Leave empty for the usual title."
        },
        "limit": {
          "type": "int",
          "label": "How many cards",
          "min": 1,
          "max": 100,
          "help": "Leave empty for the usual number."
        },
        "sorts": {
          "type": "multi",
          "label": "Shortcuts",
          "only_when": {
            "type": "browse"
          },
          "default": "artist,album,top-100,most-played",
          "options": [
            {
              "value": "title",
              "label": "Title"
            },
            {
              "value": "artist",
              "label": "Artist"
            },
            {
              "value": "album",
              "label": "Album"
            },
            {
              "value": "genre",
              "label": "Genre"
            },
            {
              "value": "playlist",
              "label": "Playlist"
            },
            {
              "value": "top-100",
              "label": "Top 100"
            },
            {
              "value": "most-played",
              "label": "Most played"
            }
          ]
        },
        "see-all": {
          "type": "bool",
          "label": "Show See All",
          "default": true
        },
        "show": {
          "type": "bool",
          "label": "Show this row",
          "default": true
        },
        "shape": {
          "type": "enum",
          "label": "Layout",
          "default": "",
          "options": [
            {
              "value": "",
              "label": "Auto: fits its space"
            },
            {
              "value": "narrow",
              "label": "Narrow"
            },
            {
              "value": "medium",
              "label": "Medium"
            },
            {
              "value": "wide",
              "label": "Wide"
            }
          ],
          "help": "Auto picks for you from the space it has: fewer cards across in a narrow space."
        }
      }
    },
