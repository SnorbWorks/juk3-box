  "container": {
    "label": "Container",
    "description": "Holds other blocks. Choose how it arranges them.",
    "settings": {
      "class": {
        "type": "class",
        "label": "Style",
        "help": "CSS classes. The theme's own, or a layout helper below."
      },
      "focus": {
        "type": "text",
        "label": "Knob group",
        "help": "A name makes the cards and buttons inside it knob stops, in reading order.",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "focus-flow": {
        "type": "enum",
        "label": "Knob flow",
        "options": [
          {
            "value": "",
            "label": "Normal"
          },
          {
            "value": "down-from-rest",
            "label": "Navigation (turning back walks down it)"
          }
        ],
        "advanced": true
      }
    },
    "helpers": [
      {
        "value": "jb-u-row",
        "label": "Row",
        "group": "arrange"
      },
      {
        "value": "jb-u-column",
        "label": "Column",
        "group": "arrange"
      },
      {
        "value": "jb-u-grid-2",
        "label": "Grid, 2 across",
        "group": "arrange"
      },
      {
        "value": "jb-u-grid-3",
        "label": "Grid, 3 across",
        "group": "arrange"
      },
      {
        "value": "jb-u-grid-4",
        "label": "Grid, 4 across",
        "group": "arrange"
      },
      {
        "value": "jb-u-gap-none",
        "label": "No gap",
        "group": "gap"
      },
      {
        "value": "jb-u-gap-small",
        "label": "Small gap",
        "group": "gap"
      },
      {
        "value": "jb-u-gap-large",
        "label": "Large gap",
        "group": "gap"
      },
      {
        "value": "jb-u-pad-small",
        "label": "Small padding",
        "group": "padding"
      },
      {
        "value": "jb-u-pad-medium",
        "label": "Medium padding",
        "group": "padding"
      },
      {
        "value": "jb-u-pad-large",
        "label": "Large padding",
        "group": "padding"
      },
      {
        "value": "jb-u-grow",
        "label": "Fill the space",
        "group": "size"
      },
      {
        "value": "jb-u-scroll",
        "label": "Scroll",
        "group": "size"
      },
      {
        "value": "jb-u-center",
        "label": "Center",
        "group": "align"
      }
    ]
  },
  "common": {
    "class": {
      "type": "class",
      "label": "Style",
      "help": "CSS classes for this block (the theme's own).",
      "advanced": true
    },
    "span": {
      "type": "enum",
      "label": "Width",
      "help": "How much of the row this takes. Auto shares the row equally with the other Auto blocks.",
      "options": [
        {
          "value": "",
          "label": "Auto"
        },
        {
          "value": "full",
          "label": "Full"
        },
        {
          "value": "1-2",
          "label": "1/2"
        },
        {
          "value": "1-3",
          "label": "1/3"
        },
        {
          "value": "2-3",
          "label": "2/3"
        },
        {
          "value": "1-4",
          "label": "1/4"
        },
        {
          "value": "3-4",
          "label": "3/4"
        }
