{
  "format": 1,
  "about": "The blocks this engine knows and the settings each takes, as data for the page builder (jb-admin) and anyone writing a theme. Keep in step with KNOWN_BLOCKS (themes.py), BLOCKS (engine/js/blocks.js) and docs/theme-format.md.",
  "layouts": {
    "frame": {
      "label": "Frame",
      "description": "What stays on screen while screens change: the sidebar, the logo, Now Playing. Holds the screen block, where every screen appears."
    },
    "home": {
      "label": "Home",
      "description": "The resting screen: your rows of cards."
    },
    "all-songs": {
      "label": "All Songs",
      "description": "The song board guests pick from with the keypad."
    },
    "collection": {
      "label": "See All",
      "description": "A row's full page, opened from See All."
    }
  },
  "groups": [
    {
      "id": "content",
      "label": "Content"
    },
    {
      "id": "patterns",
      "label": "Patterns"
    },
    {
      "id": "music",
      "label": "Music"
    },
    {
      "id": "navigation",
      "label": "Navigation"
    },
    {
      "id": "structure",
      "label": "Structure"
    }
  ],
  "patterns": [
    {
      "label": "Welcome banner",
      "detail": "Heading, text and a picture",
      "icon": "sparkles",
      "tree": {
        "class": "jb-u-row jb-u-center jb-u-pad-medium",
        "children": [
          {
            "class": "jb-u-column",
            "children": [
              {
                "block": "heading",
                "text": "Welcome to the lounge",
                "size": "large"
              },
              {
                "block": "text",
                "text": "Pick a song on the keypad: a letter, then a number."
              }
            ]
          },
          {
            "block": "image",
            "width": "medium"
          }
        ]
      }
    },
    {
      "label": "Spotlight",
      "detail": "Featured artist beside new songs",
