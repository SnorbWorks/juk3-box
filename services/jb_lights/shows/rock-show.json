      "meter": ["spectrum", "vu"],
      "keys": "eq"
    },
    "build": {"storyteller": ["chase", "sweep"], "rhythm": ["chase"], "meter": ["counter", "comet"]},
    "big": {
      "storyteller": ["beams"],
      "rhythm": ["beams", "rows"],
      "meter": ["fire", "sparks"],
      "keys": "pulse"
    },
    "solo": {"storyteller": ["beams", "sweep"], "meter": ["sparks", "fire"]}
