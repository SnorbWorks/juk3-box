    "pace": 0.6,
    "voice": 0.6
  },
  "palettes": [
    ["#FF2A00", "#FFB000", "#FFFFFF"],
    ["#FFFFFF", "#2F6BFF", "#FF2A00"],
    ["#FFB000", "#FF5A00", "#FFF2C0"],
    ["#B000FF", "#FF2A00", "#FFFFFF"]
  ],
  "peak": ["#FFFFFF", "#FFD27A", "#FF2A00"],
